<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN 互連" Width="880" MinWidth="760" MinHeight="480" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI" FontSize="14" Foreground="{DynamicResource Text}"
        xml:lang="zh-TW" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <!-- 26 = the 20px shadow margin plus 6px of the visible edge -->
    <WindowChrome ResizeBorderThickness="26" CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="Header" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="Margin" Value="14,16,0,6"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,4"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource Line}"/>
    </Style>

    <Style x:Key="Dot" TargetType="Button">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Ellipse x:Name="E" Fill="{TemplateBinding Background}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="E" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Tag" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22808080"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Tag" Value="0,14,0,0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E81123"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="0,6">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource SegOn}"/>
                <Setter TargetName="B" Property="Effect">
                  <Setter.Value><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.2"/></Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="46" Height="28">
              <Border CornerRadius="14" Background="{DynamicResource TrackOff}"/>
              <Border x:Name="On" CornerRadius="14" Background="#34C759" Opacity="0"/>
              <Ellipse Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="K"/></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3"/></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="K" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="K" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Soft" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FolderItem" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="10,6">
              <ContentPresenter HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Field}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Field}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DropZoneStyle" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Rectangle x:Name="R" RadiusX="14" RadiusY="14" Fill="{DynamicResource Card}" Stroke="{DynamicResource Sub}" StrokeThickness="1.5" StrokeDashArray="5 4"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="hi">
                <Setter TargetName="R" Property="Stroke" Value="{DynamicResource Blue}"/>
                <Setter TargetName="R" Property="StrokeThickness" Value="3"/>
                <Setter TargetName="R" Property="Fill" Value="{DynamicResource DropOn}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="R" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track">
              <Border CornerRadius="3" Background="{DynamicResource Line}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource Blue}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="7" Background="{DynamicResource Field}" BorderBrush="Transparent" BorderThickness="1.5" Padding="6,4">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Blue}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="B" CornerRadius="6" Padding="10,6" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Blue}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="7" Background="{DynamicResource Field}" Height="32">
                      <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Sub}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="10,0,28,0" VerticalAlignment="Center"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="4" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Border CornerRadius="14" Background="{DynamicResource Bg}">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.28"/></Border.Effect>
    </Border>
    <DockPanel Margin="18,0,18,18">
      <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="44" Background="Transparent">
        <StackPanel x:Name="AppleCaption" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CloseBtn" Style="{StaticResource Dot}" Background="#FF5F57" ToolTip="關閉" AutomationProperties.Name="關閉"/>
          <Button x:Name="MinBtn" Style="{StaticResource Dot}" Background="#FEBC2E" ToolTip="最小化" AutomationProperties.Name="最小化"/>
          <Button x:Name="ZoomBtn" Style="{StaticResource Dot}" Background="#28C840" ToolTip="放大/還原" AutomationProperties.Name="放大/還原"/>
        </StackPanel>
        <StackPanel x:Name="TitleText" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="LAN 互連" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="TitleTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="LangBtn" Style="{StaticResource Soft}" Background="Transparent" Foreground="{DynamicResource Sub}" Padding="8,2" FontSize="13" VerticalAlignment="Center"/>
          <Button x:Name="ThemeBtn" Style="{StaticResource Soft}" Background="Transparent" Foreground="{DynamicResource Sub}" Padding="8,2" Content="◐" FontSize="16" VerticalAlignment="Center"/>
          <Button x:Name="SettingsBtn" Style="{StaticResource Soft}" Background="Transparent" Padding="8,4" VerticalAlignment="Center" ToolTip="設定" AutomationProperties.Name="設定">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource Sub}" Stroke="{DynamicResource Sub}" StrokeThickness="0.6" StrokeLineJoin="Round"
                  Data="F0 M10.11,4.12 L10.46,1.71 L13.54,1.71 L13.89,4.12 A8.1,8.1 0 0 1 16.23,5.09 L18.19,3.64 L20.36,5.81 L18.91,7.77 A8.1,8.1 0 0 1 19.88,10.11 L22.29,10.46 L22.29,13.54 L19.88,13.89 A8.1,8.1 0 0 1 18.91,16.23 L20.36,18.19 L18.19,20.36 L16.23,18.91 A8.1,8.1 0 0 1 13.89,19.88 L13.54,22.29 L10.46,22.29 L10.11,19.88 A8.1,8.1 0 0 1 7.77,18.91 L5.81,20.36 L3.64,18.19 L5.09,16.23 A8.1,8.1 0 0 1 4.12,13.89 L1.71,13.54 L1.71,10.46 L4.12,10.11 A8.1,8.1 0 0 1 5.09,7.77 L3.64,5.81 L5.81,3.64 L7.77,5.09 A8.1,8.1 0 0 1 10.11,4.12 Z M12,8.3 A3.7,3.7 0 1 1 12,15.7 A3.7,3.7 0 1 1 12,8.3 Z"/>
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=Scroll}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="這台電腦是" Style="{StaticResource Header}" Margin="14,4,0,6"/>
            <Border Background="{DynamicResource SegBg}" CornerRadius="9" Padding="2">
              <UniformGrid Rows="1">
                <RadioButton x:Name="RoleA" Style="{StaticResource Segment}" Content="電腦 A" GroupName="Role" IsChecked="True"/>
                <RadioButton x:Name="RoleB" Style="{StaticResource Segment}" Content="電腦 B" GroupName="Role"/>
              </UniformGrid>
            </Border>
            <TextBlock x:Name="Summary" Style="{StaticResource Hint}" Margin="14,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="網路卡" Style="{StaticResource Header}"/>
            <Border Style="{StaticResource Card}" Padding="14,10">
              <StackPanel>
                <ComboBox x:Name="Adapters" AutomationProperties.Name="網路卡"/>
                <TextBlock x:Name="AdapterInfo" Style="{StaticResource Hint}" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
                <Border Style="{StaticResource Sep}" Margin="0,10,0,0"/>
                <DockPanel Margin="0,8,0,0">
                  <ToggleButton x:Name="HotspotToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="開啟 Wi-Fi 熱點"/>
                  <Button x:Name="HotspotPassBtn" Style="{StaticResource Soft}" Padding="10,4" Background="{DynamicResource Field}" Content="密碼…" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="熱點密碼"/>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="開啟 Wi-Fi 熱點"/>
                    <TextBlock x:Name="HotspotInfo" Text="沒有共同 Wi-Fi 時,讓另一台直接連到這台" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="選項" Style="{StaticResource Header}"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,8">
                  <ToggleButton x:Name="Firewall" Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="True" AutomationProperties.Name="開放防火牆給對方"/>
                  <StackPanel>
                    <TextBlock Text="開放防火牆給對方"/>
                    <TextBlock Text="只允許對方 IP 傳檔與 ping" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                  </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Margin="0,8">
                  <ToggleButton x:Name="RdpToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="允許對方遠端桌面"/>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="允許對方遠端桌面"/>
                    <TextBlock x:Name="RdpHint" Text="對方可用這台的帳號密碼登入並操作這台" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Margin="0,8">
                  <Button x:Name="AdvancedBtn" Style="{StaticResource Soft}" Padding="10,4" Background="{DynamicResource Field}" Content="設定…" DockPanel.Dock="Right" AutomationProperties.Name="進階設定"/>
                  <TextBlock Text="進階設定(IP / DNS)" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <Button x:Name="ApplyBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="一鍵設定" Margin="0,16,0,8" IsDefault="True"/>
            <Button x:Name="RestoreBtn" Style="{StaticResource Soft}" Foreground="{DynamicResource Red}" Content="還原設定"/>
          </StackPanel>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="傳送檔案" Style="{StaticResource Header}" Margin="14,4,0,6"/>
            <Button Grid.Row="1" x:Name="DropZone" Style="{StaticResource DropZoneStyle}" AllowDrop="True" MinHeight="250"
                    ToolTip="拖曳檔案或資料夾到這裡,或按一下選擇檔案" AutomationProperties.Name="傳送檔案給對方">
              <StackPanel>
                <Path Data="M6,8 H58 A4,4 0 0 1 62,12 V44 A4,4 0 0 1 58,48 H6 A4,4 0 0 1 2,44 V12 A4,4 0 0 1 6,8 Z M24,48 L22,58 H42 L40,48 M16,58 H48"
                      Stroke="{DynamicResource Blue}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="64" Height="60" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Ellipse x:Name="PeerDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PeerState" Style="{StaticResource Hint}"/>
                </StackPanel>
                <TextBlock Text="把檔案或資料夾拖到這裡,就會傳給對方" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </Button>

            <Grid Grid.Row="2" x:Name="ProgressRow" Visibility="Hidden" Margin="4,10,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                <ProgressBar x:Name="Progress" Maximum="1"/>
              </StackPanel>
              <Button x:Name="CancelBtn" Grid.Column="1" Style="{StaticResource Soft}" Background="Transparent" Foreground="{DynamicResource Red}" Padding="10,2" Content="取消" Margin="6,0,0,0"/>
            </Grid>

            <UniformGrid Grid.Row="3" Columns="2">
              <Button x:Name="TestBtn" Style="{StaticResource Soft}" Content="測試連線" Margin="0,0,4,0"/>
              <Button x:Name="SpeedBtn" Style="{StaticResource Soft}" Content="測速" Margin="4,0,0,0"/>
            </UniformGrid>
            <UniformGrid Grid.Row="4" Columns="2" Margin="0,8,0,0">
              <Button x:Name="RdpBtn" Style="{StaticResource Soft}" Content="遠端桌面連到對方" Margin="0,0,4,0"/>
              <Button x:Name="WebBtn" Style="{StaticResource Soft}" Content="開網頁給對方下載" ToolTip="對方沒裝工具、也沒設定時,用瀏覽器下載" Margin="4,0,0,0"/>
            </UniformGrid>
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="14,8" Margin="0,8,0,0">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="InboxResetBtn" Style="{StaticResource Soft}" Background="Transparent" Foreground="{DynamicResource Red}" Padding="8,2" Content="重置" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="2,0,0,0" AutomationProperties.Name="重置收件位置"/>
                  <Button x:Name="InboxPickBtn" Style="{StaticResource Soft}" Background="Transparent" Padding="8,2" Content="變更…" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="2,0,0,0" AutomationProperties.Name="變更收件位置"/>
                  <Button x:Name="InboxBtn" Style="{StaticResource Soft}" Background="Transparent" Padding="8,2" Content="開啟" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0" AutomationProperties.Name="開啟收件位置"/>
                  <StackPanel>
                    <TextBlock Text="收件位置(這台)" Style="{StaticResource Hint}"/>
                    <TextBlock x:Name="InboxPath" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                  <Button x:Name="PeerResetBtn" Style="{StaticResource Soft}" Background="Transparent" Foreground="{DynamicResource Red}" Padding="8,2" Content="重置" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="2,0,0,0" AutomationProperties.Name="重置送達位置"/>
                  <Button x:Name="PeerBrowseBtn" Style="{StaticResource Soft}" Background="Transparent" Padding="8,2" Content="瀏覽…" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="6,0,0,0" AutomationProperties.Name="瀏覽對方的資料夾"/>
                  <StackPanel>
                    <TextBlock Text="送達位置(對方)" Style="{StaticResource Hint}" Margin="0,0,0,2"/>
                    <TextBox x:Name="SendTo" ToolTip="有指定時,傳出的檔案優先存到對方的這個資料夾。請輸入完整路徑,例如 D:\收件。" AutomationProperties.Name="送達位置"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="留白時存到對方的收件位置;對方沒設定過,就是對方 Windows 的「下載」資料夾。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Grid.Row="6" x:Name="Status" Margin="14,14,14,0" FontSize="13" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
      </ScrollViewer>
    </DockPanel>

    <StackPanel x:Name="WindowsCaption" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="WinMinBtn" Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化"/>
      <Button x:Name="WinZoomBtn" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="放大/還原" AutomationProperties.Name="放大/還原"/>
      <Button x:Name="WinCloseBtn" Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="關閉" AutomationProperties.Name="關閉"/>
    </StackPanel>

    <!-- Overlays start below the title bar so the window can still be moved and closed. -->
    <Border x:Name="SettingsOverlay" Visibility="Collapsed" Margin="0,44,0,0" CornerRadius="0,0,14,14" Background="#66000000">
      <Border Style="{StaticResource Card}" Width="460" Margin="24,8" Padding="16" VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="設定" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <DockPanel Margin="0,8">
            <ToggleButton x:Name="AutoStartToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="開機時自動開啟"/>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="開機時自動開啟"/>
              <TextBlock Text="登入 Windows 後在系統匣背景執行,可以直接收檔" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Sep}"/>
          <DockPanel Margin="0,8">
            <ToggleButton x:Name="AutoUpdateToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="自動更新"/>
            <Button x:Name="CheckUpdateBtn" Style="{StaticResource Soft}" Padding="10,4" Background="{DynamicResource Field}" Content="檢查更新" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="自動更新"/>
              <TextBlock Text="自動下載新版,在關閉程式或待命時安裝" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
              <TextBlock x:Name="UpdateStatus" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Sep}"/>
          <DockPanel Margin="0,8">
            <ToggleButton x:Name="QuitOnCloseToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="關閉視窗時直接退出"/>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="關閉視窗時直接退出"/>
              <TextBlock Text="關閉後不留在系統匣,也不再接收檔案" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Sep}"/>
          <DockPanel Margin="0,8">
            <ToggleButton x:Name="AskRestoreToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="退出時詢問是否還原"/>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="退出時詢問是否還原"/>
              <TextBlock Text="退出程式前先問要不要還原網路設定" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Sep}"/>
          <DockPanel Margin="0,8">
            <ToggleButton x:Name="AutoRestoreToggle" Style="{StaticResource Switch}" DockPanel.Dock="Right" AutomationProperties.Name="每次退出自動還原"/>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="每次退出自動還原"/>
              <TextBlock Text="不再詢問,直接還原 IP、防火牆和熱點" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Border Style="{StaticResource Sep}"/>
          <DockPanel Margin="0,8">
            <Border DockPanel.Dock="Right" Width="170" Background="{DynamicResource SegBg}" CornerRadius="9" Padding="2" VerticalAlignment="Center">
              <UniformGrid Rows="1">
                <RadioButton x:Name="UiApple" Style="{StaticResource Segment}" Content="Apple" GroupName="UiStyle" IsChecked="True"/>
                <RadioButton x:Name="UiWindows" Style="{StaticResource Segment}" Content="Windows" GroupName="UiStyle"/>
              </UniformGrid>
            </Border>
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="介面樣式"/>
              <TextBlock Text="視窗按鈕的位置和圖示" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Button x:Name="SettingsDoneBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="完成" Margin="0,10,0,0"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <Border x:Name="AdvancedOverlay" Visibility="Collapsed" Margin="0,44,0,0" CornerRadius="0,0,14,14" Background="#66000000">
      <Border Style="{StaticResource Card}" Width="460" Margin="24,8" Padding="16" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="進階設定(IP / DNS)" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Grid x:Name="AdvancedPanel">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="本機 IP" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="Ip" Margin="0,2" AutomationProperties.Name="本機 IP"/>
            <TextBlock Grid.Row="1" Text="子網路遮罩" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Mask" Margin="0,2" Text="255.255.255.0" AutomationProperties.Name="子網路遮罩"/>
            <TextBlock Grid.Row="2" Text="對方 IP" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="Peer" Margin="0,2" AutomationProperties.Name="對方 IP"/>
            <TextBlock Grid.Row="3" Text="閘道(可留白)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="Gateway" Margin="0,2" AutomationProperties.Name="閘道"/>
            <TextBlock Grid.Row="4" Text="DNS(可留白)" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="Dns" Margin="0,2" ToolTip="多個請用逗號分隔" AutomationProperties.Name="DNS"/>
          </Grid>
          <UniformGrid Columns="3" Margin="0,10,0,0">
            <Button x:Name="AutoIpBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="改成自動取得 IP" ToolTip="不看備份,直接把這張網卡改回自動取得 IP 和 DNS" Margin="0,0,4,0"/>
            <Button x:Name="AdapterSettingsBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="網路介面卡…" ToolTip="開啟 Windows 的網路連線設定" Margin="2,0,2,0"/>
            <Button x:Name="AdvancedDoneBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="完成" Margin="4,0,0,0"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="WebOverlay" Visibility="Collapsed" Margin="0,44,0,0" CornerRadius="0,0,14,14" Background="#66000000">
      <Border Style="{StaticResource Card}" Width="460" Margin="24,8" Padding="16" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="開網頁給對方下載" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="WebUrl" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Blue}" TextWrapping="Wrap"/>
          <TextBlock x:Name="WebHint" Text="在另一台的瀏覽器輸入這個網址,對方不用裝工具,也不用改設定。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <StackPanel x:Name="WebFiles">
            <Border x:Name="WebDrop" AllowDrop="True" Background="{DynamicResource Field}" CornerRadius="7" Padding="10,8" Height="96">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="WebList" FontSize="13" TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
            <UniformGrid Columns="3" Margin="0,8,0,0">
              <Button x:Name="WebAddFilesBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="加入檔案…" Margin="0,0,4,0"/>
              <Button x:Name="WebAddFolderBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="加入資料夾…" Margin="2,0,2,0"/>
              <Button x:Name="WebClearBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="清空清單" Margin="4,0,0,0"/>
            </UniformGrid>
          </StackPanel>
          <UniformGrid x:Name="WebQr" Visibility="Collapsed" Columns="2">
            <StackPanel>
              <TextBlock Text="1. 掃描連上熱點" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <Image x:Name="WifiQrImage" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="1. 掃描連上熱點"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="2. 掃描開啟網頁" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <Image x:Name="UrlQrImage" Width="160" Height="160" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="2. 掃描開啟網頁"/>
            </StackPanel>
          </UniformGrid>
          <!-- No Columns: the row divides evenly among the buttons showing, and the QR button shows only for a hotspot. -->
          <UniformGrid Rows="1" Margin="0,8,0,0">
            <Button x:Name="WebStopBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Foreground="{DynamicResource Red}" Content="停止分享" Margin="0,0,4,0"/>
            <Button x:Name="WebQrBtn" Visibility="Collapsed" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="手機 QR Code" Margin="2,0,2,0"/>
            <Button x:Name="WebDoneBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="完成" Margin="4,0,0,0"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="HotspotOverlay" Visibility="Collapsed" Margin="0,44,0,0" CornerRadius="0,0,14,14" Background="#66000000">
      <Border Style="{StaticResource Card}" Width="460" Margin="24,8" Padding="16" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="熱點密碼" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox x:Name="HotspotPass" AutomationProperties.Name="熱點密碼"/>
          <TextBlock x:Name="HotspotPassHint" Text="8 到 63 個英文、數字或符號。會一併改掉 Windows 行動熱點的密碼;熱點開著時會重新啟動,已連上的裝置要用新密碼重連。" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,12"/>
          <UniformGrid Columns="2">
            <Button x:Name="HotspotPassCancelBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="取消" Margin="0,0,4,0"/>
            <Button x:Name="HotspotPassSaveBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="儲存" Margin="4,0,0,0"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="ExitOverlay" Visibility="Collapsed" Margin="0,44,0,0" CornerRadius="0,0,14,14" Background="#66000000">
      <Border Style="{StaticResource Card}" Width="460" Margin="24,8" Padding="16" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="退出前要還原網路設定嗎?" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock x:Name="ExitMessage" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button x:Name="ExitRestoreBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="還原並退出" Margin="0,0,0,8"/>
          <UniformGrid Columns="2">
            <Button x:Name="ExitOnlyBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="直接退出" Margin="0,0,4,0"/>
            <Button x:Name="ExitCancelBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="取消" Margin="4,0,0,0"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="BrowseOverlay" Visibility="Collapsed" Margin="0,44,0,0" CornerRadius="0,0,14,14" Background="#66000000">
      <Border Style="{StaticResource Card}" Width="460" Margin="24" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="選擇對方的資料夾" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="BrowseUpBtn" Style="{StaticResource Soft}" Padding="10,4" Background="{DynamicResource Field}" Content="上一層" DockPanel.Dock="Left" Margin="0,0,10,0"/>
            <TextBlock x:Name="BrowsePath" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
            <Button x:Name="BrowseCancelBtn" Style="{StaticResource Soft}" Background="{DynamicResource Field}" Content="取消" Margin="0,0,4,0"/>
            <Button x:Name="BrowseSelectBtn" Style="{StaticResource Soft}" Background="{DynamicResource Blue}" Foreground="White" FontWeight="SemiBold" Content="選這個資料夾" Margin="4,0,0,0"/>
          </UniformGrid>
          <TextBlock x:Name="BrowseMessage" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BrowseList"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
